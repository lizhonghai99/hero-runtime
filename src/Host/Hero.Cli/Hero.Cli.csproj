<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>hi</AssemblyName>
    <RootNamespace>Hero.Cli</RootNamespace>
    <Description>hi — HERO CLI host.</Description>
    <UserSecretsId>hero-agent-cli</UserSecretsId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>hi</ToolCommandName>
    <PackageId>Hero.Cli</PackageId>
    <Version>0.0.1</Version>
    <Authors>HERO</Authors>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\..\nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Hero.Core\Hero.Core.csproj" />
    <ProjectReference Include="..\..\Plugins\Hero.Plugins.Coding\Hero.Plugins.Coding.csproj" />
    <ProjectReference Include="..\..\Plugins\Hero.Plugins.DataAnalysis\Hero.Plugins.DataAnalysis.csproj" />
    <ProjectReference Include="..\..\Plugins\Hero.Plugins.Observability\Hero.Plugins.Observability.csproj" />
    <ProjectReference Include="..\..\Plugins\Hero.Plugins.Harness\Hero.Plugins.Harness.csproj" />
    <ProjectReference Include="..\..\Plugins\Hero.Plugins.Mcp\Hero.Plugins.Mcp.csproj" />
    <ProjectReference Include="..\..\Plugins\Hero.Plugins.Workflow\Hero.Plugins.Workflow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Terminal.Gui" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hero.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
