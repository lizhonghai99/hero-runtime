<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft Agent Framework (aligned with MAF Practice 04-agent / 10-harness) -->
    <PackageVersion Include="Anthropic" Version="12.57.0" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.25.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Harness" Version="1.25.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.25.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Tools.Shell" Version="1.24.0-preview.261006.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.25.0" />
    <!-- MEAI -->
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <!-- .NET hosting / config / logging: net10 GA 10.x (aligned with MAF ≥10.0.12; not 11 RC) -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <!-- MCP client -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Terminal.Gui" Version="2.5.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>